{
  "name": "stage-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-ro-helper-search-index.mjs",
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build:api": "node scripts/bundle-publish-api.mjs",
    "prebuild": "node scripts/build-ro-helper-search-index.mjs",
    "build": "tsc -b && vite build && node scripts/bundle-publish-api.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build && npm run ro-helper:validate && npm run ro-helper:audit-en -- --quiet",
    "icons": "node scripts/generate-icons-from-preview.mjs",
    "icons:st": "node scripts/apply-st-to-icon-preview.mjs && node scripts/generate-icons-from-preview.mjs",
    "ro-helper:export-review": "node scripts/export-ro-helper-review-pack.mjs",
    "ro-helper:export-relevance": "node scripts/export-ro-helper-relevance-review.mjs",
    "ro-helper:export-single": "node scripts/export-ro-helper-single-file.mjs",
    "ro-helper:apply-fixes": "node scripts/ro-helper-apply-fixes.mjs",
    "ro-helper:inject-fpsu-refs": "node scripts/inject-ro-helper-fpsu-refs.mjs",
    "ro-helper:validate": "node scripts/validate-ro-helper-content.mjs",
    "ro-helper:sync-matrix": "node scripts/sync-ro-helper-matrix-from-index.mjs",
    "ro-helper:sync-card-ids": "node scripts/sync-ro-helper-frontmatter-card-id.mjs",
    "ro-helper:build-search-index": "node scripts/build-ro-helper-search-index.mjs",
    "ro-helper:audit-en": "node scripts/ro-helper-audit-en.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "practiscore:inspect-fixture": "python scripts/practiscore/psc_inspect.py scripts/practiscore/fixtures/practiscore-roundtrip-test.psc --keys",
    "supabase": "npx supabase",
    "supabase:login": "npx supabase login",
    "supabase:link": "npx supabase link",
    "supabase:push": "npx supabase db push",
    "supabase:migration-list": "npx supabase migration list",
    "supabase:diff": "npx supabase db diff",
    "supabase:seed:match-admin": "npx supabase db query --linked -f supabase/seed/match_admin_test_seed.sql",
    "supabase:seed:match-board-extras": "npx supabase db query --linked -f supabase/seed/match_admin_seed_add_extra_board_shooters.sql",
    "supabase:seed:match-all": "npm run supabase:seed:match-admin && npm run supabase:seed:match-board-extras",
    "supabase:seed:test-match-cli-65": "npx supabase db query --linked -f supabase/seed/match_admin_fill_test_match_cli_65_shooters.sql",
    "supabase:seed:match-hub-demos": "npx supabase db query --linked -f supabase/seed/match_hub_demo_list_seed.sql",
    "supabase:seed:klassifikatsiyni-etap2": "npx supabase db query --linked -f supabase/seed/klassifikatsiyni_rushnytsia_etap2_2026_from_psc_stage1_roster.sql",
    "vercel:env-pull": "vercel env pull",
    "vercel:link": "vercel link",
    "git:sync-staging": "node scripts/sync-staging-from-main.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.103.2",
    "@vercel/analytics": "^2.0.1",
    "cropperjs": "^1.6.2",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/edge": "^1.2.2",
    "@vercel/node": "^5.7.7",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.25.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vercel": "^41.7.8",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2",
    "workbox-window": "^7.4.0"
  }
}
