# Optional: Google Analytics 4 — create a Data Stream in GA4, copy Measurement ID (G-XXXXXXXX).
# Add the same variable in Vercel → Project → Settings → Environment Variables (Production).
# Leave unset to disable GA; Vercel Web Analytics works without this.
# VITE_GA_MEASUREMENT_ID=

# Staging Vercel project only: noindex in HTML + banner in UI (do not set on production project).
# VITE_SITE_ENV=staging

# Match portal routes (portal/matches…) — unset on production until ready; vite dev defaults to enabled.
# VITE_ENABLE_MATCH_PORTAL=1

# BL-001 share link + portal auth (Supabase) — Dashboard → Settings → API. Set on Vercel (Preview/Production).
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=

# --- Local API (publish-share, match-export-psc): use npm run dev:vercel (see docs/TECH.md) ---
# After `npm run vercel:link`, pull env from the dashboard:
#   npm run vercel:env-pull   # writes .gitignored .env.local (includes SUPABASE_SERVICE_ROLE_KEY when defined in Vercel)
# Or set manually for local-only (never commit):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=https://xxxx.supabase.co
# Vercel CLI also exposes these when linked; duplicates in .env are fine if consistent.

# Vercel Serverless (api/*.js — same URLs as browser). Locally: same keys as above; optional duplicate name:
# SUPABASE_URL=https://xxxx.supabase.co
# (or rely on VITE_SUPABASE_URL — handlers read both)
# Public base URL for copied share links (short domain or production host). Optional: if unset on Vercel,
# the API uses VERCEL_PROJECT_PRODUCTION_URL (system) so preview deploys do not embed *-team-projects in links.
# VITE_SHARE_PUBLIC_ORIGIN=https://shooters-tools.com
